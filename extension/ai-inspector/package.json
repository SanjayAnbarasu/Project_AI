{
  "name": "ai-inspector",
  "displayName": "Ai-Inspector",
  "description": "Automated Terminal Error Capture Agent",
  "publisher": "sanjayAnbarasu",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:aiInspectorDashboard",
    "onCommand:ai-inspector.sendError",
    "onCommand:aiInspector.showActivity"
  ],
  "enabledApiProposals": [
    "terminalDataWriteEvent"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-inspector.sendError",
        "title": "Ai-Inspector: Send Error"
      },
      {
        "command": "aiInspector.showActivity",
        "title": "AI Inspector: Show Activity Log"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiInspector",
          "title": "AI Inspector",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiInspector": [
        {
          "icon": "icon.svg",
          "type": "webview",
          "id": "aiInspectorDashboard",
          "name": "Dashboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.18.1"
  }
}
